# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed — it holds a real Gmail
# app password. This template holds placeholders only.

# ── Email ─────────────────────────────────────────────────────────────────────
# Gmail address the alert is sent FROM.
SENDER_EMAIL=you@gmail.com

# 16-character Gmail App Password (NOT your normal login password).
# Requires 2-Step Verification: https://myaccount.google.com/apppasswords
# Keep the spaces exactly as Google displays them.
SENDER_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Address the alert is delivered TO. May be the same as SENDER_EMAIL.
RECIPIENT_EMAIL=you@gmail.com

# ── What to watch ─────────────────────────────────────────────────────────────
# Case-insensitive SUBSTRING of the film title as Regal returns it.
# Use the most distinctive single word — "dhurandhar hindi" will not match
# "Dhurandhar The Revenge (Hindi)" because it is not contiguous.
MOVIE_TITLE=dhurandhar

# Date you want to see the movie, MM-DD-YYYY.
TARGET_DATE=03-27-2026

# ── Optional ──────────────────────────────────────────────────────────────────
# Override recipient for manual test runs. Leave blank to use RECIPIENT_EMAIL.
TEST_RECIPIENT_EMAIL=
