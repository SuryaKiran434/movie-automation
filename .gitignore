# Credentials — never commit
.env

# Runtime files
*.log
.notified
.last_heartbeat
.monitor.lock

# Chromium profile for the browser fallback (cookies/cache only, no credentials)
.browser-profile/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Virtualenvs. run_now.sh resolves ./venv or ./.venv as its interpreter when
# nothing else is activated, so these are expected to exist locally.
venv/
.venv/

# macOS
.DS_Store

# Editor / tooling
.claude/
.vscode/
.idea/
